<section class="film film-whip" id="whiplash">
  <div class="film-bg-glow"></div>
  <div class="film-inner">
    <div class="film-poster-wrap reveal">
      <div class="poster-frame">
        <span class="year-tag">2014</span>
        <img src="http://www.impawards.com/2014/posters/whiplash_ver2.jpg" alt="Whiplash poster" loading="lazy"/>
        <div class="rating"><span class="rating-stars">★★★★★</span><span class="rating-num">8.5</span></div>
      </div>
      <p class="poster-caption">Dir. Damien Chazelle · Sony Pictures Classics · Design: Cold Open</p>
    </div>
    <div class="film-text">
      <span class="film-label reveal">Film Three · Drama</span>
      <h2 class="film-title reveal"><em>WHIPLASH</em></h2>
      <p class="film-director reveal">Directed by Damien Chazelle</p>
      <p class="film-synopsis reveal">Andrew Neiman is a first-year drummer at the most prestigious music conservatory in America. Terence Fletcher is the conductor who will either make him or break him — possibly both. What follows is one of cinema's most brutal examinations of obsession, greatness, and the cost of demanding the absolute most from yourself.</p>
      <p class="film-synopsis reveal">Chazelle edited this film to feel like jazz — unpredictable, relentless, building to something you don't see coming. The final ten minutes are as good as anything put on screen in the last thirty years. You will not breathe.</p>
      <div class="film-quote reveal">"There are no two words in the English language more harmful than 'good job.'"</div>
      <div class="film-pills reveal">
        <span class="pill">Miles Teller</span><span class="pill">J.K. Simmons</span>
        <span class="pill">Academy Award</span><span class="pill">106 min</span>
      </div>
      <div class="film-credits reveal reveal-late">
        <div class="credit"><span class="credit-label">Director</span><span class="credit-val">Damien Chazelle</span></div>
        <div class="credit"><span class="credit-label">Screenplay</span><span class="credit-val">Damien Chazelle</span></div>
        <div class="credit"><span class="credit-label">Cinematography</span><span class="credit-val">Sharone Meir</span></div>
        <div class="credit"><span class="credit-label">Music</span><span class="credit-val">Justin Hurwitz</span></div>
      </div>
    </div>
  </div>
</section>

<!-- FOOTER -->
<footer>
  <p class="foot-eyebrow">End of Programme</p>
  <div class="foot-title">Good <span>Cinema</span><br>Never Ends</div>
  <p>A curated triple-bill broadcast · One night only</p>
  <p>All film posters belong to their respective studios and distributors. Used for editorial purposes.</p>
</footer>

<script>
  // Scroll reveal
  const els = document.querySelectorAll('.reveal');
  const io = new IntersectionObserver(entries => {
    entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); io.unobserve(e.target); } });
  }, { threshold: 0.1 });
  els.forEach(el => io.observe(el));

  // Rain effect for Se7en scene
  const canvas = document.getElementById('rainCanvas');
  if (canvas) {
    for (let i = 0; i < 55; i++) {
      const drop = document.createElement('div');
      drop.className = 'rain-drop';
      const left = Math.random() * 100;
      const duration = 0.5 + Math.random() * 0.8;
      const delay = -Math.random() * 2;
      const height = 14 + Math.random() * 20;
      const opacity = 0.2 + Math.random() * 0.4;
      drop.style.cssText = `left:${left}%;height:${height}px;opacity:${opacity};animation-duration:${duration}s;animation-delay:${delay}s;`;
      canvas.appendChild(drop);
    }
  }
</script>
</body>
</html>
